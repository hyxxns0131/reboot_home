SECRET_KEY=
FLASK_DEBUG=1
DATABASE_URL=
ADMIN_EMAIL=
ADMIN_PASSWORD=
CUSTOMER_EMAIL=
CUSTOMER_PASSWORD=
SEED_DUMMY_DATA=1
COOKIE_SECURE=0
# OpenAI 키 (챗봇 · 챗봇 질문 AI 분석 · 관리자 AI 비서). OPEN_API_KEY / open_api_key 이름도 읽습니다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# 상세페이지 AI 이미지 (선택): 모델 · 품질(low/medium/high)
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=medium
# Higgsfield (선택, 상세페이지 이미지): console.higgsfield.ai → API keys. 키 ID + 시크릿 (또는 HIGGSFIELD_API_KEY=id:secret)
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=
HIGGSFIELD_IMAGE_MODEL=higgsfield/ads-studio/v1.0

# Dashboard data API (README §39): long random value; send it to the dashboard owner privately
EXPORT_API_TOKEN=
